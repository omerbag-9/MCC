# Copy to .dev.vars for local development (never commit .dev.vars).
NEXTJS_ENV=development

# Cloudflare Turnstile test keys (always pass). Replace with real keys in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend (leave empty locally to just log emails to the console)
RESEND_API_KEY=


# Optional: R2 S3 API credentials for direct browser uploads (needed for large videos in production)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Allows /admin on localhost during `npm run preview` (ignored on any other host)
ADMIN_DEV_BYPASS=1
SITE_URL=http://localhost:8787
APP_ENV=dev

# Dev-environment admin password (only used on APP_ENV=dev when Cloudflare Access isn't set up;
# localhost never needs it). In CI it comes from the GitHub "dev" environment secret ADMIN_PASSWORD.
# ADMIN_PASSWORD=
