{
  "name": "mcc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build --openNextConfigPath open-next.config.dev.ts && opennextjs-cloudflare preview",
    "deploy:dev": "opennextjs-cloudflare build --openNextConfigPath open-next.config.dev.ts && opennextjs-cloudflare deploy && node scripts/post-deploy.mjs dev",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging && node scripts/post-deploy.mjs staging",
    "deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production && node scripts/post-deploy.mjs production",
    "secrets:sync": "node scripts/sync-secrets.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=./scripts/seed.sql",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote",
    "db:seed:dev": "node scripts/seed-if-empty.mjs dev",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.16",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  }
}
