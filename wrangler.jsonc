{
  "$schema": "node_modules/wrangler/config-schema.json",
  /*
   * Three environments, each with its own Worker, D1 database and R2 buckets:
   *
   *   dev        (top level)        npm run deploy:dev         https://mcc-dev.<account>.workers.dev
   *   staging    (env.staging)      npm run deploy:staging     https://staging.example.com
   *   production (env.production)   npm run deploy:production  https://example.com
   *
   * Local development (`npm run dev` / `npm run preview`) uses the top-level bindings, simulated
   * locally by Wrangler. Bindings, vars and routes are NOT inherited by environments, so each
   * environment repeats them in full.
   *
   * Replace every 00000000... id with the real D1 database ids (see README).
   */

  // ---------------------------------------------------------------- shared settings (inherited)
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // ---------------------------------------------------------------- dev (default)
  "name": "mcc-dev",
  "workers_dev": true,
  "services": [
    // Self-reference required by the OpenNext cache. Must match this environment's worker name.
    { "binding": "WORKER_SELF_REFERENCE", "service": "mcc-dev" }
  ],
  "d1_databases": [
    // App data: projects, services, leads, ...
    { "binding": "DB", "database_name": "mcc_db", "database_id": "852c51bb-2ce9-45bd-8543-c8283f4ef951", "migrations_dir": "drizzle" },
    // Same database, used by OpenNext to track page revalidations.
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "mcc_db", "database_id": "852c51bb-2ce9-45bd-8543-c8283f4ef951" }
  ],
  // Dev uses one bucket for both: uploads live under projects/ site/ clients/ and the page cache
  // under incremental-cache/. (Staging and production use separate buckets.)
  "r2_buckets": [
    // Uploaded images and videos
    { "binding": "MEDIA", "bucket_name": "mcc-bucket" },
    // OpenNext page cache
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "mcc-bucket" }
  ],
  // Non-secret configuration. Secrets: `wrangler secret put NAME [--env ...]` (remote) or .dev.vars (local).
  "vars": {
    "APP_ENV": "dev",
    "SITE_URL": "https://mcc-dev.example.workers.dev",
    "MEDIA_URL": "",
    "EMAIL_FROM": "Website (dev) <noreply@example.com>",
    "LEADS_NOTIFY_TO": "dev-team@example.com",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "R2_ACCOUNT_ID": "",
    "R2_BUCKET_NAME": "mcc-bucket",
    "TURNSTILE_SITE_KEY": "",
    "CF_ANALYTICS_TOKEN": ""
  },

  "env": {
    // -------------------------------------------------------------- staging
    "staging": {
      "name": "mcc-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "staging.example.com", "custom_domain": true }],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "mcc-staging" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "mcc-db-staging", "database_id": "00000000-0000-0000-0000-000000000002", "migrations_dir": "drizzle" },
        { "binding": "NEXT_TAG_CACHE_D1", "database_name": "mcc-db-staging", "database_id": "00000000-0000-0000-0000-000000000002" }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "mcc-media-staging" },
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "mcc-cache-staging" }
      ],
      "vars": {
        "APP_ENV": "staging",
        "SITE_URL": "https://staging.example.com",
        "MEDIA_URL": "",
        "EMAIL_FROM": "Website (staging) <noreply@example.com>",
        "LEADS_NOTIFY_TO": "dev-team@example.com",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "CF_ACCESS_AUD": "",
        "R2_ACCOUNT_ID": "",
        "R2_BUCKET_NAME": "mcc-media-staging",
        "TURNSTILE_SITE_KEY": "",
        "CF_ANALYTICS_TOKEN": ""
      }
    },

    // -------------------------------------------------------------- production
    "production": {
      "name": "mcc",
      "workers_dev": false,
      "routes": [
        { "pattern": "example.com", "custom_domain": true },
        { "pattern": "www.example.com", "custom_domain": true }
      ],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "mcc" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "mcc-db", "database_id": "00000000-0000-0000-0000-000000000003", "migrations_dir": "drizzle" },
        { "binding": "NEXT_TAG_CACHE_D1", "database_name": "mcc-db", "database_id": "00000000-0000-0000-0000-000000000003" }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "mcc-media" },
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "mcc-cache" }
      ],
      "vars": {
        "APP_ENV": "production",
        "SITE_URL": "https://example.com",
        "MEDIA_URL": "",
        "EMAIL_FROM": "Website <noreply@example.com>",
        "LEADS_NOTIFY_TO": "info@example.com",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "CF_ACCESS_AUD": "",
        "R2_ACCOUNT_ID": "",
        "R2_BUCKET_NAME": "mcc-media",
        "TURNSTILE_SITE_KEY": "",
        "CF_ANALYTICS_TOKEN": ""
      }
    }
  }
}
